# Copy to .env.local for local work. On Netlify, set the same names under
# Site configuration > Environment variables. Real values never go in this file.

# --- Supabase (accounts, cloud decks, live rooms) ---
# Public: compiled into the page on purpose. Use the anon / publishable key, never service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# --- Claude connector (the server function; Netlify environment only, never compiled into the page) ---
# The SERVICE ROLE key lets netlify/functions/mcp.mjs write decks for the person a connector link belongs to.
# Never put it in SUPABASE_ANON_KEY or anywhere the page can read it. Without it the connector is simply off.
SUPABASE_SERVICE_ROLE_KEY=
