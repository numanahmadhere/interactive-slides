# Copy to .env.local for local work. On Netlify, set the same names under
# Site configuration > Environment variables. Real values never go in this file.

# --- Supabase (accounts, cloud decks, live rooms) ---
# Public: compiled into the page on purpose. Use the anon / publishable key, never service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# --- Paddle checkout (the page) ---
# The client-side token only opens checkout, so it is public. It starts with test_ (sandbox) or
# live_ (live). The build refuses a server API key (pdl_...) here. Leave empty to switch checkout off.
# Use a test_ token for the sandbox price ids in src/billing/catalog.js, a live_ token for the live ones.
PADDLE_CLIENT_TOKEN=
# Which Paddle account the token belongs to: sandbox or live. Required whenever the token is set and
# never guessed; the build stops if it is missing or does not match the token's prefix.
PADDLE_ENV=

# --- Paddle webhook (the server function; Netlify environment only, never compiled into the page) ---
# One secret per notification destination: Developer tools > Notifications, in each Paddle account.
# Point both destinations at https://YOUR-SITE/api/paddle-webhook
PADDLE_WEBHOOK_SECRET_LIVE=
PADDLE_WEBHOOK_SECRET_SANDBOX=
# The SERVICE ROLE key lets the webhook write subscriptions. Server only. Never put it in
# SUPABASE_ANON_KEY or anywhere the page can read it.
SUPABASE_SERVICE_ROLE_KEY=
